{
  "name": "pi-comfy-handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi workflow editing and ComfyUI generation through a host VRAM manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkkk8402/pi-comfy-handoff.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\"",
    "pretest": "node -e \"require('node:fs').mkdirSync('work/tmp', {recursive:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "manager": "node dist/src/manager.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.4.3",
    "typescript": "^5.9.3"
  }
}
