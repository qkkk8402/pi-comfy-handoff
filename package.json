{
  "name": "pi-comfy-handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi workflow editing and ComfyUI generation with llama-server VRAM handoff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkkk8402/pi-comfy-handoff.git"
  },
  "engines": { "node": ">=22" },
  "pi": { "extensions": ["./src/extension.ts"] },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\"",
    "pretest": "node -e \"require('node:fs').mkdirSync('work/tmp', {recursive:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": { "typebox": "^1.3.7" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": ">=0.83.0" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
